# Copy this file's values as needed — CyberShield works out of the box
# with these defaults. All variables are prefixed CYBERSHIELD_ and are
# optional; sensible defaults live in app/core/config.py.

CYBERSHIELD_APP_NAME=CyberShield
CYBERSHIELD_DEBUG=true

# SQLite by default. Point this at Postgres/MySQL for a real deployment,
# e.g. CYBERSHIELD_DATABASE_URL=postgresql://user:pass@localhost/cybershield
CYBERSHIELD_DATABASE_URL=sqlite:///./database/cybershield.db

CYBERSHIELD_MAX_UPLOAD_MB=25
CYBERSHIELD_RATE_LIMIT_PER_MINUTE=60

# Comma-separated list of allowed origins, or "*" for any (fine for local dev).
CYBERSHIELD_CORS_ORIGINS=*
